CREATE TABLE public.menu_item (id uuid PRIMARY KEY DEFAULT gen_random_uuid(), name_es text NOT NULL UNIQUE, name_en text NOT NULL, category text NOT NULL CHECK(category IN ('entree','side','appetizer','dessert','beverage')), portion_size_oz numeric, serving_description text, base_yield_servings numeric, is_upsell boolean NOT NULL DEFAULT false, dietary_tags text[] NOT NULL DEFAULT '{}', active boolean NOT NULL DEFAULT true);
CREATE TABLE public.ingredient (id uuid PRIMARY KEY DEFAULT gen_random_uuid(), name text NOT NULL UNIQUE, unit text NOT NULL, unit_cost_usd numeric NOT NULL CHECK(unit_cost_usd >= 0), supplier text, waste_pct numeric NOT NULL DEFAULT 0 CHECK(waste_pct >= 0 AND waste_pct < 100), last_updated timestamptz NOT NULL DEFAULT now(), cost_data_label text NOT NULL DEFAULT 'Synthetic demo data');
CREATE TABLE public.recipe_line (id uuid PRIMARY KEY DEFAULT gen_random_uuid(), menu_item_id uuid NOT NULL REFERENCES public.menu_item(id), ingredient_id uuid NOT NULL REFERENCES public.ingredient(id), qty_per_serving numeric NOT NULL CHECK(qty_per_serving > 0), unit text NOT NULL, UNIQUE(menu_item_id, ingredient_id));
CREATE TABLE public.menu_package (id uuid PRIMARY KEY DEFAULT gen_random_uuid(), name text NOT NULL UNIQUE, description text NOT NULL, is_default boolean NOT NULL DEFAULT false);
CREATE TABLE public.menu_package_component (id uuid PRIMARY KEY DEFAULT gen_random_uuid(), package_id uuid NOT NULL REFERENCES public.menu_package(id), menu_item_id uuid REFERENCES public.menu_item(id), category_choice text, quantity integer NOT NULL DEFAULT 1, CHECK ((menu_item_id IS NOT NULL) <> (category_choice IS NOT NULL)));
CREATE TABLE public.service_package (id uuid PRIMARY KEY DEFAULT gen_random_uuid(), service_style text NOT NULL UNIQUE CHECK(service_style IN ('dropoff','setup','full_service')), name text NOT NULL, description text NOT NULL);
ALTER TABLE public.menu_item ENABLE ROW LEVEL SECURITY; ALTER TABLE public.ingredient ENABLE ROW LEVEL SECURITY; ALTER TABLE public.recipe_line ENABLE ROW LEVEL SECURITY; ALTER TABLE public.menu_package ENABLE ROW LEVEL SECURITY; ALTER TABLE public.menu_package_component ENABLE ROW LEVEL SECURITY; ALTER TABLE public.service_package ENABLE ROW LEVEL SECURITY;
CREATE POLICY "public reads active menu" ON public.menu_item FOR SELECT TO anon, authenticated USING (active = true);
CREATE POLICY "owner manages menu" ON public.menu_item FOR ALL TO authenticated USING (EXISTS (SELECT 1 FROM public.mesa_staff WHERE user_id=auth.uid() AND role='owner')) WITH CHECK (EXISTS (SELECT 1 FROM public.mesa_staff WHERE user_id=auth.uid() AND role='owner'));
CREATE POLICY "owner manages ingredients" ON public.ingredient FOR ALL TO authenticated USING (EXISTS (SELECT 1 FROM public.mesa_staff WHERE user_id=auth.uid() AND role='owner')) WITH CHECK (EXISTS (SELECT 1 FROM public.mesa_staff WHERE user_id=auth.uid() AND role='owner'));
CREATE POLICY "owner manages recipes" ON public.recipe_line FOR ALL TO authenticated USING (EXISTS (SELECT 1 FROM public.mesa_staff WHERE user_id=auth.uid() AND role='owner')) WITH CHECK (EXISTS (SELECT 1 FROM public.mesa_staff WHERE user_id=auth.uid() AND role='owner'));
CREATE POLICY "public reads packages" ON public.menu_package FOR SELECT TO anon, authenticated USING (true);
CREATE POLICY "owner manages packages" ON public.menu_package FOR ALL TO authenticated USING (EXISTS (SELECT 1 FROM public.mesa_staff WHERE user_id=auth.uid() AND role='owner')) WITH CHECK (EXISTS (SELECT 1 FROM public.mesa_staff WHERE user_id=auth.uid() AND role='owner'));
CREATE POLICY "public reads package components" ON public.menu_package_component FOR SELECT TO anon, authenticated USING (true);
CREATE POLICY "owner manages package components" ON public.menu_package_component FOR ALL TO authenticated USING (EXISTS (SELECT 1 FROM public.mesa_staff WHERE user_id=auth.uid() AND role='owner')) WITH CHECK (EXISTS (SELECT 1 FROM public.mesa_staff WHERE user_id=auth.uid() AND role='owner'));
CREATE POLICY "public reads service packages" ON public.service_package FOR SELECT TO anon, authenticated USING (true);
CREATE POLICY "owner manages service packages" ON public.service_package FOR ALL TO authenticated USING (EXISTS (SELECT 1 FROM public.mesa_staff WHERE user_id=auth.uid() AND role='owner')) WITH CHECK (EXISTS (SELECT 1 FROM public.mesa_staff WHERE user_id=auth.uid() AND role='owner')); 