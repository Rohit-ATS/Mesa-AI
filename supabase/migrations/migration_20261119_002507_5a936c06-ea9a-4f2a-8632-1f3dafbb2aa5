-- ===== Catering-rule quotes, allergies, and three-step release =====

-- 1. Owner-only per-dish pricing and portions (menu_item is publicly readable, so prices live separately)
create table if not exists public.mesa_menu_price (
  menu_item_id uuid primary key references public.menu_item(id) on delete cascade,
  price_per_serving numeric check (price_per_serving is null or price_per_serving >= 0),
  servings_per_guest numeric not null default 1 check (servings_per_guest > 0 and servings_per_guest <= 20),
  updated_at timestamptz not null default now()
);
alter table public.mesa_menu_price enable row level security;
create policy "owner manages menu prices" on public.mesa_menu_price for all to authenticated
  using (exists (select 1 from public.mesa_staff where user_id = auth.uid() and role = 'owner'))
  with check (exists (select 1 from public.mesa_staff where user_id = auth.uid() and role = 'owner'));
insert into public.mesa_menu_price (menu_item_id) select id from public.menu_item on conflict do nothing;

-- 2. New settings (tax rate and SF surcharge start empty; staffing charge is a labelled sample)
insert into public.cost_setting (key, value_numeric, unit, description, editable, data_provenance) values
 ('sf_delivery_surcharge', null, 'USD flat fee', 'Flat San Francisco delivery surcharge, added as its own quote line when the venue is in San Francisco. Empty until you enter it — quotes show "Price needed".', true, 'sample'),
 ('sales_tax_rate_pct', null, '% of quote subtotal', 'Sales tax rate for customer quotes. While empty, quotes read "Tax: pending — will be confirmed before your event" and totals are labelled before tax.', true, 'sample'),
 ('staff_charge_hourly', 35, 'USD per staff hour', 'Sample value — hourly rate charged to the customer for each service staff member on the staffing line.', true, 'sample')
on conflict (key) do nothing;

-- 3. Structured allergies and preferences
create table if not exists public.mesa_dietary_intake (
  inquiry_id uuid primary key references public.inquiry(id) on delete cascade,
  allergies_none boolean not null default false,
  preferences_none boolean not null default false,
  created_at timestamptz not null default now()
);
alter table public.mesa_dietary_intake enable row level security;
create policy "owner reads dietary intake" on public.mesa_dietary_intake for select to authenticated
  using (exists (select 1 from public.mesa_staff where user_id = auth.uid() and role = 'owner'));

create table if not exists public.mesa_accommodation (
  id uuid primary key default gen_random_uuid(),
  inquiry_id uuid not null references public.inquiry(id) on delete cascade,
  kind text not null check (kind in ('allergy','preference')),
  label text not null check (length(btrim(label)) between 1 and 80),
  guest_count integer not null check (guest_count > 0),
  alt_menu_item_id uuid references public.menu_item(id),
  alt_servings numeric check (alt_servings is null or alt_servings > 0),
  alt_confirmed_at timestamptz,
  cross_contact_reviewed boolean not null default false,
  cross_contact_reviewed_at timestamptz,
  created_at timestamptz not null default now()
);
create index if not exists mesa_accommodation_inquiry_idx on public.mesa_accommodation(inquiry_id);
alter table public.mesa_accommodation enable row level security;
create policy "owner manages accommodations" on public.mesa_accommodation for all to authenticated
  using (exists (select 1 from public.mesa_staff where user_id = auth.uid() and role = 'owner'))
  with check (exists (select 1 from public.mesa_staff where user_id = auth.uid() and role = 'owner'));
create trigger mesa_notice_accommodation after insert or update or delete on public.mesa_accommodation for each row execute function public.mesa_notify_change();

-- Menu coverage: an accommodation is covered when a chosen entree (or any dish if no entree) carries a matching tag.
create or replace function public.mesa_accommodation_covered(p_inquiry uuid, p_label text)
returns boolean language sql stable set search_path = public as $$
  with t as (select case lower(btrim(p_label)) when 'vegetarian' then array['vegetarian','vegan'] when 'vegan' then array['vegan'] when 'gluten/wheat' then array['gluten_free'] when 'gluten-free' then array['gluten_free'] else null end as tags),
  d as (select m.category, m.dietary_tags from public.order_line o join public.menu_item m on m.id = o.menu_item_id where o.inquiry_id = p_inquiry),
  pool as (select * from d where category = 'entree' or not exists (select 1 from d where category = 'entree'))
  select coalesce((select t.tags is not null and exists (select 1 from pool where pool.dietary_tags && t.tags) from t), false)
$$;

-- 4. Per-quote line edits (owner draft) and frozen customer quote versions
create table if not exists public.mesa_quote_draft (
  inquiry_id uuid primary key references public.inquiry(id) on delete cascade,
  overrides jsonb not null default '{}'::jsonb check (jsonb_typeof(overrides) = 'object'),
  sf_surcharge boolean,
  updated_at timestamptz not null default now()
);
alter table public.mesa_quote_draft enable row level security;
create policy "owner manages quote drafts" on public.mesa_quote_draft for all to authenticated
  using (exists (select 1 from public.mesa_staff where user_id = auth.uid() and role = 'owner'))
  with check (exists (select 1 from public.mesa_staff where user_id = auth.uid() and role = 'owner'));

create table if not exists public.mesa_quote_version (
  id uuid primary key default gen_random_uuid(),
  inquiry_id uuid not null references public.inquiry(id) on delete cascade,
  quote_id uuid references public.quote(id) on delete set null,
  version integer not null,
  lines jsonb not null,
  subtotal numeric not null,
  tax_amount numeric,
  tax_rate_pct numeric,
  total numeric not null,
  status text not null default 'sent' check (status in ('sent','accepted','superseded','cancelled')),
  token_hash text not null unique,
  customer_email text not null,
  email_status text check (email_status in ('accepted','failed','unknown','skipped')),
  email_error text,
  approved_by uuid references auth.users(id) on delete set null,
  created_at timestamptz not null default now(),
  accepted_at timestamptz,
  closed_at timestamptz,
  unique (inquiry_id, version)
);
alter table public.mesa_quote_version enable row level security;
create policy "owner reads quote versions" on public.mesa_quote_version for select to authenticated
  using (exists (select 1 from public.mesa_staff where user_id = auth.uid() and role = 'owner'));
create trigger mesa_notice_quote_version after insert or update or delete on public.mesa_quote_version for each row execute function public.mesa_notify_change();

-- 5. Exactly one kitchen ticket per inquiry
create table if not exists public.mesa_kitchen_release (
  inquiry_id uuid primary key references public.inquiry(id) on delete cascade,
  version_id uuid not null references public.mesa_quote_version(id),
  dishes jsonb not null default '[]'::jsonb,
  released_by uuid references auth.users(id) on delete set null,
  released_at timestamptz not null default now(),
  customer_email text,
  email_status text check (email_status in ('accepted','failed','unknown','skipped')),
  email_error text
);
alter table public.mesa_kitchen_release enable row level security;
create policy "owner reads kitchen releases" on public.mesa_kitchen_release for select to authenticated
  using (exists (select 1 from public.mesa_staff where user_id = auth.uid() and role = 'owner'));
create trigger mesa_notice_release after insert or update or delete on public.mesa_kitchen_release for each row execute function public.mesa_notify_change();

-- Confirmed ticket dishes; legacy approved orders fall back to their order lines.
create or replace function public.mesa_ticket_dishes(p_inquiry uuid)
returns table (menu_item_id uuid, servings numeric, alternative_for text) language sql stable set search_path = public as $$
  select (d->>'menu_item_id')::uuid, (d->>'servings')::numeric, d->>'alternative_for'
    from public.mesa_kitchen_release r, jsonb_array_elements(r.dishes) d where r.inquiry_id = p_inquiry
  union all
  select o.menu_item_id, o.qty_servings, null::text from public.order_line o
   where o.inquiry_id = p_inquiry and not exists (select 1 from public.mesa_kitchen_release r where r.inquiry_id = p_inquiry)
$$;

-- 6. Step 1: owner approves the quote (freezes lines, no kitchen work)
create or replace function public.mesa_approve_quote_version(p_inquiry_id uuid, p_customer_email text, p_lines jsonb, p_quote jsonb default null)
returns jsonb language plpgsql security definer set search_path = public, extensions as $$
declare v_status text; v_event timestamptz; v_guests integer; v_cust uuid; v_email text; v_line jsonb; v_lines jsonb := '[]'::jsonb;
  v_kind text; v_qty numeric; v_price numeric; v_amount numeric; v_sub numeric := 0; v_tax numeric; v_tax_seen boolean := false; v_dishes integer := 0;
  v_version integer; v_quote uuid; v_token text; v_rate numeric; v_acc record; v_item uuid; v_accom uuid; src public.quote%rowtype; v_cost numeric; v_version_id uuid; v_note text;
begin
  if not exists (select 1 from public.mesa_staff where user_id = auth.uid() and role = 'owner') then raise exception 'Owner access required'; end if;
  select i.status, (i.event_date + i.event_time) at time zone 'America/Los_Angeles', i.guest_count, i.customer_id into v_status, v_event, v_guests, v_cust from public.inquiry i where i.id = p_inquiry_id for update;
  if not found then raise exception 'Inquiry not found'; end if;
  if v_status = 'declined' then raise exception 'This inquiry was declined'; end if;
  if v_status = 'approved' or exists (select 1 from public.mesa_kitchen_release where inquiry_id = p_inquiry_id) then raise exception 'Already released to the kitchen — the quote can no longer change'; end if;
  if v_event is null then raise exception 'Event date and time are required'; end if;
  if v_guests is null or v_guests < 10 then raise exception 'La Bandera Kitchen caters a minimum of 10 guests'; end if;
  v_email := lower(nullif(btrim(coalesce(p_customer_email, '')), ''));
  if v_email is null or v_email !~ '^[^\s@<>]+@[^\s@<>]+\.[^\s@<>]+$' or length(v_email) > 254 then raise exception 'A valid customer email is required'; end if;
  if p_lines is null or jsonb_typeof(p_lines) <> 'array' or jsonb_array_length(p_lines) = 0 or jsonb_array_length(p_lines) > 100 then raise exception 'The quote has no lines'; end if;

  for v_line in select value from jsonb_array_elements(p_lines) loop
    v_kind := v_line->>'kind';
    if v_kind is null or v_kind not in ('dish','optional','alternative','delivery','sf_surcharge','staffing','tax') then raise exception 'Invalid quote line'; end if;
    if coalesce(length(btrim(v_line->>'label')), 0) = 0 or length(v_line->>'label') > 160 or length(coalesce(v_line->>'note', '')) > 300 or length(coalesce(v_line->>'unit', '')) > 40 then raise exception 'Invalid quote line label or note'; end if;
    v_note := nullif(btrim(coalesce(v_line->>'note', '')), '');
    if v_kind = 'tax' then
      if v_tax_seen then raise exception 'Only one tax line is allowed'; end if;
      v_tax_seen := true;
      v_tax := round(nullif(v_line->>'amount', '')::numeric, 2);
      if v_tax is not null and v_tax < 0 then raise exception 'Tax cannot be negative'; end if;
      v_lines := v_lines || jsonb_build_array(jsonb_build_object('key', v_line->>'key', 'kind', 'tax', 'label', btrim(v_line->>'label'), 'amount', v_tax, 'note', v_note));
      continue;
    end if;
    v_qty := nullif(v_line->>'qty', '')::numeric; v_price := nullif(v_line->>'unit_price', '')::numeric;
    if v_qty is null or v_qty <= 0 then raise exception 'Quantity needed for %', v_line->>'label'; end if;
    if v_price is null then raise exception 'Price needed for %', v_line->>'label'; end if;
    if v_price < 0 then raise exception 'Price cannot be negative for %', v_line->>'label'; end if;
    v_item := null; v_accom := null;
    if v_kind in ('dish','optional','alternative') then
      v_item := nullif(v_line->>'menu_item_id', '')::uuid;
      if v_item is null or not exists (select 1 from public.menu_item where id = v_item) then raise exception 'Unknown dish on line %', v_line->>'label'; end if;
    end if;
    if v_kind = 'alternative' then
      v_accom := nullif(v_line->>'accommodation_id', '')::uuid;
      if v_accom is null or not exists (select 1 from public.mesa_accommodation where id = v_accom and inquiry_id = p_inquiry_id) then raise exception 'Alternative line % is not linked to an accommodation', v_line->>'label'; end if;
    end if;
    v_amount := round(v_qty * v_price, 2); v_sub := v_sub + v_amount;
    if v_kind = 'dish' then v_dishes := v_dishes + 1; end if;
    v_lines := v_lines || jsonb_build_array(jsonb_build_object('key', v_line->>'key', 'kind', v_kind, 'label', btrim(v_line->>'label'), 'qty', v_qty, 'unit', nullif(btrim(coalesce(v_line->>'unit', '')), ''), 'unit_price', v_price, 'amount', v_amount, 'note', v_note, 'menu_item_id', v_item, 'accommodation_id', v_accom));
  end loop;
  if v_dishes = 0 then raise exception 'Add at least one dish line'; end if;

  for v_acc in select * from public.mesa_accommodation where inquiry_id = p_inquiry_id loop
    if v_acc.guest_count > v_guests then raise exception '% (% guests) is more than the % guests on this event', v_acc.label, v_acc.guest_count, v_guests; end if;
    if not public.mesa_accommodation_covered(p_inquiry_id, v_acc.label) and (v_acc.alt_menu_item_id is null or v_acc.alt_servings is null) then
      raise exception 'Enter a confirmed alternative for % (% guests) before sending', v_acc.label, v_acc.guest_count;
    end if;
  end loop;

  select value_numeric into v_rate from public.cost_setting where key = 'sales_tax_rate_pct';
  select coalesce(max(version), 0) + 1 into v_version from public.quote where inquiry_id = p_inquiry_id;
  if p_quote is not null then
    v_cost := nullif(p_quote->>'total_cost', '')::numeric;
    insert into public.quote (inquiry_id, food_cost, labor_cost, overhead_cost, transport_cost, packaging_cost, tax, total_cost, recommended_price, margin_pct, price_per_guest, competitor_low, competitor_high, competitor_percentile, assumptions_json, version, status)
    values (p_inquiry_id, (p_quote->>'food_cost')::numeric, (p_quote->>'labor_cost')::numeric, (p_quote->>'overhead_cost')::numeric, (p_quote->>'transport_cost')::numeric, (p_quote->>'packaging_cost')::numeric, v_tax, v_cost, v_sub,
      case when v_cost is not null and v_sub > 0 then (v_sub - v_cost) / v_sub end, v_sub / v_guests,
      (p_quote->>'competitor_low')::numeric, (p_quote->>'competitor_high')::numeric, (p_quote->>'competitor_percentile')::numeric,
      jsonb_build_object('assumptions', p_quote->'assumptions', 'quote_inputs', p_quote->'quote_inputs', 'customer_lines', v_lines), v_version, 'approved') returning id into v_quote;
  else
    select * into src from public.quote where inquiry_id = p_inquiry_id order by version desc limit 1;
    insert into public.quote (inquiry_id, food_cost, labor_cost, overhead_cost, transport_cost, packaging_cost, tax, total_cost, recommended_price, margin_pct, price_per_guest, competitor_low, competitor_high, competitor_percentile, assumptions_json, version, status)
    values (p_inquiry_id, src.food_cost, src.labor_cost, src.overhead_cost, src.transport_cost, src.packaging_cost, v_tax, src.total_cost, v_sub,
      case when src.total_cost is not null and v_sub > 0 then (v_sub - src.total_cost) / v_sub end, v_sub / v_guests,
      src.competitor_low, src.competitor_high, src.competitor_percentile, coalesce(src.assumptions_json, '{}'::jsonb) || jsonb_build_object('customer_lines', v_lines), v_version, 'approved') returning id into v_quote;
  end if;

  update public.mesa_quote_version set status = 'superseded', closed_at = now() where inquiry_id = p_inquiry_id and status in ('sent','accepted');
  v_token := encode(extensions.gen_random_bytes(32), 'hex');
  insert into public.mesa_quote_version (inquiry_id, quote_id, version, lines, subtotal, tax_amount, tax_rate_pct, total, token_hash, customer_email, approved_by)
  values (p_inquiry_id, v_quote, v_version, v_lines, v_sub, v_tax, v_rate, v_sub + coalesce(v_tax, 0), encode(extensions.digest(v_token, 'sha256'), 'hex'), v_email, auth.uid()) returning id into v_version_id;
  update public.customer set email = v_email where id = v_cust;
  update public.inquiry set status = 'quoted' where id = p_inquiry_id;
  return jsonb_build_object('version_id', v_version_id, 'version', v_version, 'token', v_token);
end $$;

-- Owner cancels a sent quote before acceptance
create or replace function public.mesa_cancel_quote_version(p_inquiry_id uuid)
returns integer language plpgsql security definer set search_path = public as $$
declare v_version integer;
begin
  if not exists (select 1 from public.mesa_staff where user_id = auth.uid() and role = 'owner') then raise exception 'Owner access required'; end if;
  perform 1 from public.inquiry where id = p_inquiry_id for update;
  if not found then raise exception 'Inquiry not found'; end if;
  if exists (select 1 from public.mesa_kitchen_release where inquiry_id = p_inquiry_id) then raise exception 'Already released to the kitchen'; end if;
  update public.mesa_quote_version set status = 'cancelled', closed_at = now() where inquiry_id = p_inquiry_id and status = 'sent' returning version into v_version;
  if v_version is null then raise exception 'There is no sent quote waiting for acceptance'; end if;
  update public.inquiry set status = 'new' where id = p_inquiry_id and status = 'quoted';
  return v_version;
end $$;

-- 7. Step 2: customer views / accepts via secure token (latest version only)
create or replace function public.mesa_customer_quote(p_token text)
returns jsonb language plpgsql stable security definer set search_path = public, extensions as $$
declare r record; v_latest integer; v_state text;
begin
  if p_token is null or p_token !~ '^[a-f0-9]{64}$' then return jsonb_build_object('state', 'not_found'); end if;
  select v.*, i.status as inquiry_status, i.event_date, i.event_time, i.guest_count, i.service_style, i.venue_address, c.name as customer_name
    into r from public.mesa_quote_version v join public.inquiry i on i.id = v.inquiry_id left join public.customer c on c.id = i.customer_id
   where v.token_hash = encode(extensions.digest(p_token, 'sha256'), 'hex');
  if not found then return jsonb_build_object('state', 'not_found'); end if;
  select max(version) into v_latest from public.mesa_quote_version where inquiry_id = r.inquiry_id;
  v_state := case when r.inquiry_status = 'declined' then 'declined' when r.version < v_latest or r.status = 'superseded' then 'superseded' when r.status = 'cancelled' then 'cancelled' when r.status = 'accepted' then 'accepted' else 'open' end;
  if v_state in ('superseded','cancelled','declined') then return jsonb_build_object('state', v_state, 'version', r.version, 'latest_version', v_latest); end if;
  return jsonb_build_object('state', v_state, 'version', r.version, 'lines', r.lines, 'subtotal', r.subtotal, 'tax_amount', r.tax_amount, 'total', r.total, 'accepted_at', r.accepted_at,
    'released', exists (select 1 from public.mesa_kitchen_release k where k.inquiry_id = r.inquiry_id),
    'customer_name', regexp_replace(coalesce(r.customer_name, ''), '^Demo · ', ''),
    'event', jsonb_build_object('date', r.event_date, 'time', r.event_time, 'guests', r.guest_count, 'service_style', r.service_style, 'venue_address', r.venue_address),
    'accommodations', coalesce((select jsonb_agg(jsonb_build_object('kind', a.kind, 'label', a.label, 'guests', a.guest_count) order by a.kind, a.created_at) from public.mesa_accommodation a where a.inquiry_id = r.inquiry_id), '[]'::jsonb));
end $$;

create or replace function public.mesa_accept_quote(p_token text)
returns jsonb language plpgsql security definer set search_path = public, extensions as $$
declare v record; v_latest integer; v_inq text;
begin
  if p_token is null or p_token !~ '^[a-f0-9]{64}$' then return jsonb_build_object('state', 'not_found'); end if;
  select id, inquiry_id, version, status, accepted_at into v from public.mesa_quote_version where token_hash = encode(extensions.digest(p_token, 'sha256'), 'hex');
  if not found then return jsonb_build_object('state', 'not_found'); end if;
  select status into v_inq from public.inquiry where id = v.inquiry_id for update;
  select max(version) into v_latest from public.mesa_quote_version where inquiry_id = v.inquiry_id;
  if v.status = 'accepted' and v.version = v_latest then return jsonb_build_object('state', 'accepted', 'version', v.version, 'accepted_at', v.accepted_at); end if;
  if v_inq = 'declined' then return jsonb_build_object('state', 'declined'); end if;
  if v.version < v_latest or v.status = 'superseded' then return jsonb_build_object('state', 'superseded', 'version', v.version, 'latest_version', v_latest); end if;
  if v.status <> 'sent' or v_inq <> 'quoted' then return jsonb_build_object('state', 'cancelled', 'version', v.version); end if;
  update public.mesa_quote_version set status = 'accepted', accepted_at = now() where id = v.id;
  return jsonb_build_object('state', 'accepted', 'version', v.version, 'accepted_at', now());
end $$;
grant execute on function public.mesa_customer_quote(text) to anon, authenticated;
grant execute on function public.mesa_accept_quote(text) to anon, authenticated;

-- 8. Step 3: owner releases to the kitchen (exactly one ticket)
create or replace function public.mesa_release_to_kitchen(p_inquiry_id uuid)
returns jsonb language plpgsql security definer set search_path = public as $$
declare v_status text; v_event timestamptz; v_guests integer; v_ver public.mesa_quote_version%rowtype; v_prep numeric; v_dishes jsonb;
begin
  if not exists (select 1 from public.mesa_staff where user_id = auth.uid() and role = 'owner') then raise exception 'Owner access required'; end if;
  select i.status, (i.event_date + i.event_time) at time zone 'America/Los_Angeles', i.guest_count into v_status, v_event, v_guests from public.inquiry i where i.id = p_inquiry_id for update;
  if not found then raise exception 'Inquiry not found'; end if;
  if exists (select 1 from public.mesa_kitchen_release where inquiry_id = p_inquiry_id) then
    return jsonb_build_object('already', true, 'version', (select v.version from public.mesa_kitchen_release k join public.mesa_quote_version v on v.id = k.version_id where k.inquiry_id = p_inquiry_id));
  end if;
  if v_status = 'approved' then raise exception 'This order was approved before the three-step process and is already on the kitchen board'; end if;
  if v_status <> 'quoted' then raise exception 'Approve the quote and wait for the customer to accept it first'; end if;
  select * into v_ver from public.mesa_quote_version where inquiry_id = p_inquiry_id order by version desc limit 1;
  if not found or v_ver.status <> 'accepted' then raise exception 'The customer has not accepted the latest quote (v%) yet', v_ver.version; end if;
  if v_event is null then raise exception 'Event date and time are required'; end if;

  select coalesce(jsonb_agg(jsonb_build_object('menu_item_id', l->>'menu_item_id', 'servings', (l->>'qty')::numeric,
           'alternative_for', case when l->>'kind' = 'alternative' then (select initcap(a.kind) || ': ' || a.label || ' (' || a.guest_count || ' guests)' from public.mesa_accommodation a where a.id = (l->>'accommodation_id')::uuid) end)), '[]'::jsonb)
    into v_dishes from jsonb_array_elements(v_ver.lines) l where l->>'kind' in ('dish','optional','alternative') and l->>'menu_item_id' is not null;

  insert into public.mesa_kitchen_release (inquiry_id, version_id, dishes, released_by, customer_email) values (p_inquiry_id, v_ver.id, v_dishes, auth.uid(), v_ver.customer_email);

  select coalesce((select value_numeric from public.cost_setting where key = 'base_prep_hours'), 2)
       + v_guests * coalesce((select value_numeric from public.cost_setting where key = 'prep_min_per_guest'), 0) / 60.0 into v_prep;
  if not exists (select 1 from public.prep_task where inquiry_id = p_inquiry_id) then
    insert into public.prep_task (inquiry_id, menu_item_id, qty_servings, prep_notes, due_at)
    select p_inquiry_id, d.menu_item_id, d.servings, case when d.alternative_for is not null then 'Alternative meal — ' || d.alternative_for end, v_event - (v_prep * interval '1 hour')
      from public.mesa_ticket_dishes(p_inquiry_id) d where d.servings > 0;
  end if;

  update public.inquiry set status = 'approved' where id = p_inquiry_id;
  insert into public.mesa_inquiry_decision (inquiry_id, decision, decided_by, customer_email) values (p_inquiry_id, 'approved', auth.uid(), v_ver.customer_email)
    on conflict (inquiry_id) do update set decision = 'approved', decided_by = excluded.decided_by, decided_at = now(), customer_email = excluded.customer_email, email_status = null, email_error = null;
  return jsonb_build_object('already', false, 'version', v_ver.version, 'customer_email', v_ver.customer_email);
end $$;

-- 9. Old single-step approval now only declines; approval goes through the three steps
create or replace function public.mesa_decide_inquiry(p_inquiry_id uuid, p_decision text, p_customer_email text default null, p_quote jsonb default null)
returns uuid language plpgsql security definer set search_path = public as $$
declare cur_status text;
begin
  if not exists (select 1 from public.mesa_staff where user_id = auth.uid() and role = 'owner') then raise exception 'Owner access required'; end if;
  if p_decision = 'approved' then raise exception 'Approval now has three steps: approve the quote, wait for the customer to accept it, then release to the kitchen'; end if;
  if p_decision <> 'declined' then raise exception 'Invalid decision'; end if;
  select status into cur_status from public.inquiry where id = p_inquiry_id for update;
  if not found then raise exception 'Inquiry not found'; end if;
  if cur_status in ('approved','declined') then raise exception 'This inquiry was already %', cur_status; end if;
  update public.mesa_quote_version set status = 'cancelled', closed_at = now() where inquiry_id = p_inquiry_id and status in ('sent','accepted');
  update public.inquiry set status = 'declined' where id = p_inquiry_id;
  insert into public.mesa_inquiry_decision (inquiry_id, decision, decided_by) values (p_inquiry_id, 'declined', auth.uid())
    on conflict (inquiry_id) do update set decision = 'declined', decided_by = excluded.decided_by, decided_at = now();
  return null;
end $$;

-- 10. Kitchen: released orders only (status approved), with allergies, alternatives and cross-contact review
create or replace function public.mesa_kitchen_orders()
returns jsonb language plpgsql security definer set search_path = public as $$
declare result jsonb;
begin
  if not exists (select 1 from public.mesa_staff where user_id = auth.uid() and role = 'kitchen') then raise exception 'Kitchen access required'; end if;
  select coalesce(jsonb_agg(jsonb_build_object(
    'id', i.id, 'event_date', i.event_date, 'event_time', i.event_time, 'venue_area', i.venue_zip, 'guest_count', i.guest_count,
    'dietary_flags', i.dietary_flags, 'dietary_confirmed', coalesce(mc.dietary_confirmed, false),
    'dishes', coalesce((select jsonb_agg(jsonb_build_object('name_es', m.name_es, 'name_en', m.name_en, 'servings', d.servings, 'batch_yield', m.base_yield_servings, 'alternative_for', d.alternative_for,
        'recipe', coalesce((select jsonb_agg(jsonb_build_object('name', ing.name, 'qty', r.qty_per_serving * d.servings, 'unit', r.unit)) from public.recipe_line r join public.ingredient ing on ing.id = r.ingredient_id where r.menu_item_id = m.id), '[]'::jsonb)))
      from public.mesa_ticket_dishes(i.id) d join public.menu_item m on m.id = d.menu_item_id), '[]'::jsonb),
    'timeline', coalesce((select jsonb_agg(jsonb_build_object('dish', m.name_es, 'due_at', t.due_at) order by t.due_at) from public.prep_task t join public.menu_item m on m.id = t.menu_item_id where t.inquiry_id = i.id), '[]'::jsonb),
    'checklist', coalesce((select jsonb_object_agg(c.item_key, c.done) from public.kitchen_checklist c where c.inquiry_id = i.id), '{}'::jsonb),
    'allergies', coalesce((select jsonb_agg(jsonb_build_object('id', a.id, 'label', a.label, 'guests', a.guest_count, 'alternative', am.name_es, 'alternative_en', am.name_en, 'alternative_servings', a.alt_servings, 'covered_by_menu', public.mesa_accommodation_covered(i.id, a.label), 'reviewed', a.cross_contact_reviewed) order by a.created_at)
      from public.mesa_accommodation a left join public.menu_item am on am.id = a.alt_menu_item_id where a.inquiry_id = i.id and a.kind = 'allergy'), '[]'::jsonb),
    'preferences', coalesce((select jsonb_agg(jsonb_build_object('id', a.id, 'label', a.label, 'guests', a.guest_count, 'alternative', am.name_es, 'alternative_en', am.name_en, 'alternative_servings', a.alt_servings, 'covered_by_menu', public.mesa_accommodation_covered(i.id, a.label)) order by a.created_at)
      from public.mesa_accommodation a left join public.menu_item am on am.id = a.alt_menu_item_id where a.inquiry_id = i.id and a.kind = 'preference'), '[]'::jsonb),
    'breakdown_recorded', exists (select 1 from public.mesa_dietary_intake di where di.inquiry_id = i.id),
    'pre_three_step', not exists (select 1 from public.mesa_kitchen_release k where k.inquiry_id = i.id)
  ) order by i.event_date, i.event_time), '[]'::jsonb) into result
  from public.inquiry i left join public.inquiry_metrics_context mc on mc.inquiry_id = i.id where i.status = 'approved';
  return result;
end $$;

create or replace function public.mesa_kitchen_cross_contact(p_accommodation uuid, p_done boolean)
returns void language plpgsql security definer set search_path = public as $$
begin
  if not exists (select 1 from public.mesa_staff where user_id = auth.uid() and role = 'kitchen') then raise exception 'Kitchen access required'; end if;
  update public.mesa_accommodation a set cross_contact_reviewed = coalesce(p_done, false), cross_contact_reviewed_at = case when p_done then now() end
   where a.id = p_accommodation and a.kind = 'allergy' and exists (select 1 from public.inquiry i where i.id = a.inquiry_id and i.status = 'approved');
  if not found then raise exception 'Allergy on a released order required'; end if;
  if not coalesce(p_done, false) then update public.kitchen_checklist set done = false where inquiry_id = (select inquiry_id from public.mesa_accommodation where id = p_accommodation) and item_key = 'dietary'; end if;
end $$;

create or replace function public.mesa_kitchen_check(p_inquiry uuid, p_key text, p_done boolean)
returns void language plpgsql security definer set search_path = public as $$
begin
  if not exists (select 1 from public.mesa_staff where user_id = auth.uid() and role = 'kitchen') then raise exception 'Kitchen access required'; end if;
  if not exists (select 1 from public.inquiry where id = p_inquiry and status = 'approved') then raise exception 'Approved order required'; end if;
  if p_done and p_key = 'dietary' and exists (select 1 from public.mesa_accommodation where inquiry_id = p_inquiry and kind = 'allergy' and not cross_contact_reviewed) then
    raise exception 'Confirm cross-contact review for every allergy first';
  end if;
  insert into public.kitchen_checklist (inquiry_id, item_key, done) values (p_inquiry, p_key, p_done) on conflict (inquiry_id, item_key) do update set done = excluded.done;
end $$;

-- 11. Intake: 10-guest minimum, structured allergies/preferences, portions per guest
create or replace function public.mesa_submit_demo_inquiry(p_session text, p_details jsonb, p_dishes text[])
returns uuid language plpgsql security definer set search_path = public, extensions as $$
declare t_id uuid; existing uuid; customer_id_new uuid; inquiry_id_new uuid; guest integer; dish_count integer; v_email text;
  v_structured boolean; v_flags text[] := array[]::text[]; v_entry jsonb; v_kind text; v_group jsonb; v_label text; v_count integer; v_none boolean;
begin
  if p_session !~ '^[a-f0-9]{64}$' or p_details is null or p_dishes is null or array_length(p_dishes, 1) is null or array_length(p_dishes, 1) > 25 then raise exception 'Invalid request'; end if;
  select id into t_id from public.mesa_intake_threads where session_hash = encode(extensions.digest(p_session, 'sha256'), 'hex') and agent_id = '5c072189-22b5-4cf5-bfed-d02903f578b6' for update;
  if t_id is null then raise exception 'Start the intake conversation before submitting'; end if;
  select inquiry_id into existing from public.mesa_demo_submissions where thread_id = t_id; if existing is not null then return existing; end if;
  if coalesce(length(trim(p_details->>'name')), 0) = 0 or length(p_details->>'name') > 120 or coalesce(length(trim(p_details->>'address')), 0) = 0 or length(p_details->>'address') > 250 or p_details->>'service' not in ('dropoff','setup','full_service') then raise exception 'Complete all required fields'; end if;
  v_email := lower(trim(coalesce(p_details->>'email', '')));
  if v_email !~ '^[^\s@<>]+@[^\s@<>]+\.[^\s@<>]+$' or length(v_email) > 254 then raise exception 'A valid email is required'; end if;
  guest := (p_details->>'guests')::integer;
  if guest is null or guest > 10000 or (p_details->>'date')::date is null or (p_details->>'time')::time is null then raise exception 'Invalid event details'; end if;
  if guest < 10 then raise exception 'La Bandera Kitchen caters a minimum of 10 guests'; end if;

  v_structured := jsonb_typeof(p_details->'allergies') = 'object' and jsonb_typeof(p_details->'preferences') = 'object';
  if v_structured then
    foreach v_kind in array array['allergies','preferences'] loop
      v_group := p_details->v_kind; v_none := coalesce((v_group->>'none')::boolean, false);
      if jsonb_typeof(coalesce(v_group->'items', '[]'::jsonb)) <> 'array' or jsonb_array_length(coalesce(v_group->'items', '[]'::jsonb)) > 15 then raise exception 'Invalid % list', v_kind; end if;
      if v_none = (jsonb_array_length(coalesce(v_group->'items', '[]'::jsonb)) > 0) then raise exception 'Answer the % question: choose None or list each one with a guest count', v_kind; end if;
      for v_entry in select value from jsonb_array_elements(coalesce(v_group->'items', '[]'::jsonb)) loop
        v_label := btrim(coalesce(v_entry->>'label', '')); v_count := (v_entry->>'guests')::integer;
        if length(v_label) = 0 or length(v_label) > 80 then raise exception 'Each % needs a name', v_kind; end if;
        if v_count is null or v_count < 1 then raise exception 'Enter how many guests need %', v_label; end if;
        if v_count > guest then raise exception '% guests for % is more than the % guests attending', v_count, v_label, guest; end if;
        v_flags := v_flags || ((case when v_kind = 'allergies' then 'Allergy: ' else 'Preference: ' end) || v_label || ' (' || v_count || ' guests)');
      end loop;
    end loop;
    if array_length(v_flags, 1) is null then v_flags := array['None']; end if;
  else
    if coalesce(length(trim(p_details->>'dietary')), 0) = 0 or length(p_details->>'dietary') > 250 then raise exception 'Complete all required fields'; end if;
    v_flags := array[trim(p_details->>'dietary')];
  end if;

  select count(*) into dish_count from public.menu_item where active and name_es = any(p_dishes);
  if dish_count <> array_length(p_dishes, 1) then raise exception 'Invalid menu selection'; end if;
  insert into public.customer (name, email, org_type) values ('Demo · ' || trim(p_details->>'name'), v_email, null) returning id into customer_id_new;
  insert into public.inquiry (customer_id, raw_text, channel, event_date, event_time, guest_count, service_style, venue_address, dietary_flags, completeness_score, missing_fields, status)
  values (customer_id_new, 'Synthetic demo inquiry submitted through intake.', 'demo', (p_details->>'date')::date, (p_details->>'time')::time, guest, p_details->>'service', trim(p_details->>'address'), v_flags, 100, array[]::text[], 'new') returning id into inquiry_id_new;
  insert into public.order_line (inquiry_id, menu_item_id, qty_servings)
  select inquiry_id_new, m.id, ceil(guest * coalesce(p.servings_per_guest, 1)) from public.menu_item m left join public.mesa_menu_price p on p.menu_item_id = m.id where m.active and m.name_es = any(p_dishes);
  if v_structured then
    insert into public.mesa_dietary_intake (inquiry_id, allergies_none, preferences_none) values (inquiry_id_new, coalesce((p_details->'allergies'->>'none')::boolean, false), coalesce((p_details->'preferences'->>'none')::boolean, false));
    insert into public.mesa_accommodation (inquiry_id, kind, label, guest_count)
    select inquiry_id_new, 'allergy', btrim(e->>'label'), (e->>'guests')::integer from jsonb_array_elements(coalesce(p_details->'allergies'->'items', '[]'::jsonb)) e
    union all
    select inquiry_id_new, 'preference', btrim(e->>'label'), (e->>'guests')::integer from jsonb_array_elements(coalesce(p_details->'preferences'->'items', '[]'::jsonb)) e;
  end if;
  insert into public.inquiry_metrics_context (inquiry_id, dietary_confirmed, synthetic_demo) values (inquiry_id_new, true, true);
  insert into public.mesa_demo_submissions (thread_id, inquiry_id) values (t_id, inquiry_id_new);
  return inquiry_id_new;
end $$;
