CREATE TABLE public.customer (id uuid PRIMARY KEY DEFAULT gen_random_uuid(), name text NOT NULL, email text, phone text, org_type text, notes text, created_at timestamptz NOT NULL DEFAULT now());
CREATE TABLE public.inquiry (id uuid PRIMARY KEY DEFAULT gen_random_uuid(), customer_id uuid NOT NULL REFERENCES public.customer(id), raw_text text NOT NULL DEFAULT '', channel text, event_date date, event_time time, guest_count integer, service_style text CHECK (service_style IN ('dropoff','setup','full_service')), venue_address text, venue_zip text, distance_mi numeric, event_duration_hours numeric, dietary_flags text[] NOT NULL DEFAULT '{}', budget_hint numeric, completeness_score integer, missing_fields text[] NOT NULL DEFAULT '{}', status text NOT NULL DEFAULT 'new' CHECK (status IN ('new','clarifying','quoted','approved','declined')), upsell_value_usd numeric, created_at timestamptz NOT NULL DEFAULT now());
CREATE TABLE public.order_line (id uuid PRIMARY KEY DEFAULT gen_random_uuid(), inquiry_id uuid NOT NULL REFERENCES public.inquiry(id), menu_item_id uuid NOT NULL REFERENCES public.menu_item(id), qty_servings numeric NOT NULL CHECK (qty_servings > 0), note text);
CREATE TABLE public.quote (id uuid PRIMARY KEY DEFAULT gen_random_uuid(), inquiry_id uuid NOT NULL REFERENCES public.inquiry(id), food_cost numeric, labor_cost numeric, overhead_cost numeric, transport_cost numeric, packaging_cost numeric, tax numeric, total_cost numeric, recommended_price numeric, margin_pct numeric, price_per_guest numeric, competitor_low numeric, competitor_high numeric, competitor_percentile numeric, assumptions_json jsonb, version integer NOT NULL, status text NOT NULL CHECK (status IN ('draft','approved','sent')), created_at timestamptz NOT NULL DEFAULT now(), UNIQUE(inquiry_id,version));
CREATE TABLE public.prep_task (id uuid PRIMARY KEY DEFAULT gen_random_uuid(), inquiry_id uuid NOT NULL REFERENCES public.inquiry(id), menu_item_id uuid NOT NULL REFERENCES public.menu_item(id), qty_servings numeric NOT NULL, prep_notes text, station text, due_at timestamptz NOT NULL, done boolean NOT NULL DEFAULT false);
CREATE TABLE public.competitor_benchmark (id uuid PRIMARY KEY DEFAULT gen_random_uuid(), business_name text NOT NULL, city text NOT NULL, price_per_guest_dropoff numeric, price_per_guest_full_service numeric, min_guests integer, source_url text, researched_on date NOT NULL);
ALTER TABLE public.customer ENABLE ROW LEVEL SECURITY; ALTER TABLE public.inquiry ENABLE ROW LEVEL SECURITY; ALTER TABLE public.order_line ENABLE ROW LEVEL SECURITY; ALTER TABLE public.quote ENABLE ROW LEVEL SECURITY; ALTER TABLE public.prep_task ENABLE ROW LEVEL SECURITY; ALTER TABLE public.competitor_benchmark ENABLE ROW LEVEL SECURITY;
CREATE POLICY "owner manages customers" ON public.customer FOR ALL TO authenticated USING (EXISTS (SELECT 1 FROM public.mesa_staff WHERE user_id=auth.uid() AND role='owner')) WITH CHECK (EXISTS (SELECT 1 FROM public.mesa_staff WHERE user_id=auth.uid() AND role='owner'));
CREATE POLICY "owner manages inquiries" ON public.inquiry FOR ALL TO authenticated USING (EXISTS (SELECT 1 FROM public.mesa_staff WHERE user_id=auth.uid() AND role='owner')) WITH CHECK (EXISTS (SELECT 1 FROM public.mesa_staff WHERE user_id=auth.uid() AND role='owner'));
CREATE POLICY "owner manages order lines" ON public.order_line FOR ALL TO authenticated USING (EXISTS (SELECT 1 FROM public.mesa_staff WHERE user_id=auth.uid() AND role='owner')) WITH CHECK (EXISTS (SELECT 1 FROM public.mesa_staff WHERE user_id=auth.uid() AND role='owner'));
CREATE POLICY "owner manages quotes" ON public.quote FOR ALL TO authenticated USING (EXISTS (SELECT 1 FROM public.mesa_staff WHERE user_id=auth.uid() AND role='owner')) WITH CHECK (EXISTS (SELECT 1 FROM public.mesa_staff WHERE user_id=auth.uid() AND role='owner'));
CREATE POLICY "owner manages prep tasks" ON public.prep_task FOR ALL TO authenticated USING (EXISTS (SELECT 1 FROM public.mesa_staff WHERE user_id=auth.uid() AND role='owner')) WITH CHECK (EXISTS (SELECT 1 FROM public.mesa_staff WHERE user_id=auth.uid() AND role='owner'));
CREATE POLICY "owner manages benchmarks" ON public.competitor_benchmark FOR ALL TO authenticated USING (EXISTS (SELECT 1 FROM public.mesa_staff WHERE user_id=auth.uid() AND role='owner')) WITH CHECK (EXISTS (SELECT 1 FROM public.mesa_staff WHERE user_id=auth.uid() AND role='owner'));
CREATE POLICY "kitchen reads approved tasks" ON public.prep_task FOR SELECT TO authenticated USING (EXISTS (SELECT 1 FROM public.mesa_staff s WHERE s.user_id=auth.uid() AND s.role='kitchen') AND EXISTS (SELECT 1 FROM public.inquiry i WHERE i.id=prep_task.inquiry_id AND i.status='approved'));
