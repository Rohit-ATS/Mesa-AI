CREATE TABLE public.mesa_staff (user_id uuid PRIMARY KEY REFERENCES auth.users(id), role text NOT NULL CHECK (role IN ('owner','kitchen')));
ALTER TABLE public.mesa_staff ENABLE ROW LEVEL SECURITY;
CREATE POLICY "staff can read own role" ON public.mesa_staff FOR SELECT TO authenticated USING (user_id = auth.uid());
CREATE TABLE public.business_context (id uuid PRIMARY KEY DEFAULT gen_random_uuid(), section text NOT NULL UNIQUE, content text NOT NULL, updated_at timestamptz NOT NULL DEFAULT now());
ALTER TABLE public.business_context ENABLE ROW LEVEL SECURITY;
CREATE POLICY "owner reads context" ON public.business_context FOR SELECT TO authenticated USING (EXISTS (SELECT 1 FROM public.mesa_staff WHERE user_id = auth.uid() AND role = 'owner'));
CREATE POLICY "owner updates context" ON public.business_context FOR UPDATE TO authenticated USING (EXISTS (SELECT 1 FROM public.mesa_staff WHERE user_id = auth.uid() AND role = 'owner')) WITH CHECK (EXISTS (SELECT 1 FROM public.mesa_staff WHERE user_id = auth.uid() AND role = 'owner'));
CREATE FUNCTION public.mesa_context_updated() RETURNS trigger LANGUAGE plpgsql SET search_path = public AS $$ BEGIN NEW.updated_at = now(); RETURN NEW; END $$;
CREATE TRIGGER mesa_context_timestamp BEFORE UPDATE ON public.business_context FOR EACH ROW EXECUTE FUNCTION public.mesa_context_updated();
