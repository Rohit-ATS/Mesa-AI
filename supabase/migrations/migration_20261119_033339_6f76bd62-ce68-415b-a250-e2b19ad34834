-- ===== Dietary resolution, AI prep start, in-app messaging =====

alter table public.mesa_dietary_intake add column if not exists owner_note text check (owner_note is null or length(owner_note) <= 300);
alter table public.mesa_dietary_intake add column if not exists resolved_by uuid references auth.users(id) on delete set null;
alter table public.mesa_dietary_intake add column if not exists resolved_at timestamptz;
create policy "owner records dietary resolution" on public.mesa_dietary_intake for insert to authenticated
  with check (exists (select 1 from public.mesa_staff where user_id = auth.uid() and role = 'owner'));
create policy "owner updates dietary resolution" on public.mesa_dietary_intake for update to authenticated
  using (exists (select 1 from public.mesa_staff where user_id = auth.uid() and role = 'owner'))
  with check (exists (select 1 from public.mesa_staff where user_id = auth.uid() and role = 'owner'));

create or replace function public.mesa_dietary_unresolved(p_inquiry uuid)
returns boolean language sql stable set search_path = public as $$
  select exists (select 1 from public.inquiry i, unnest(coalesce(i.dietary_flags, array[]::text[])) f
                 where i.id = p_inquiry and length(btrim(f)) > 0 and lower(btrim(f)) not in ('none', 'no', 'n/a', 'na'))
     and not exists (select 1 from public.mesa_dietary_intake d where d.inquiry_id = p_inquiry)
     and not exists (select 1 from public.mesa_accommodation a where a.inquiry_id = p_inquiry)
$$;

alter table public.mesa_kitchen_release add column if not exists prep_start_at timestamptz;
alter table public.mesa_kitchen_release add column if not exists prep_start_reason text;
alter table public.mesa_kitchen_release add column if not exists prep_start_source text check (prep_start_source in ('ai', 'standard'));
alter table public.mesa_kitchen_release add column if not exists reminder_sent_at timestamptz;
alter table public.mesa_kitchen_release add column if not exists reminder_email_status text check (reminder_email_status in ('accepted','failed','unknown','skipped'));

create table if not exists public.mesa_assistant_conversation (
  id uuid primary key default gen_random_uuid(),
  owner_id uuid not null references auth.users(id) on delete cascade,
  title text not null default 'New conversation' check (length(title) <= 120),
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now()
);
alter table public.mesa_assistant_conversation enable row level security;
create policy "owner reads own assistant conversations" on public.mesa_assistant_conversation for select to authenticated
  using (owner_id = auth.uid() and exists (select 1 from public.mesa_staff where user_id = auth.uid() and role = 'owner'));
create policy "owner starts own assistant conversations" on public.mesa_assistant_conversation for insert to authenticated
  with check (owner_id = auth.uid() and exists (select 1 from public.mesa_staff where user_id = auth.uid() and role = 'owner'));

create table if not exists public.mesa_message (
  id uuid primary key default gen_random_uuid(),
  channel text not null check (channel in ('owner', 'kitchen', 'team', 'assistant')),
  conversation_id uuid references public.mesa_assistant_conversation(id) on delete cascade,
  sender_kind text not null check (sender_kind in ('system', 'user', 'assistant')),
  sender_id uuid references auth.users(id) on delete set null,
  sender_label text check (sender_label is null or length(sender_label) <= 80),
  title text check (title is null or length(title) <= 160),
  body text not null check (length(btrim(body)) between 1 and 8000),
  inquiry_id uuid references public.inquiry(id) on delete set null,
  link text check (link is null or link ~ '^/[A-Za-z0-9/_?=&.-]*$'),
  dedupe_key text unique,
  created_at timestamptz not null default now(),
  check ((channel = 'assistant') = (conversation_id is not null))
);
create index if not exists mesa_message_channel_idx on public.mesa_message(channel, created_at desc);
create index if not exists mesa_message_conversation_idx on public.mesa_message(conversation_id, created_at);
alter table public.mesa_message enable row level security;
create policy "staff read their channels" on public.mesa_message for select to authenticated using (
  exists (select 1 from public.mesa_staff s where s.user_id = auth.uid() and (
    (s.role = 'owner' and channel in ('owner', 'kitchen', 'team'))
    or (s.role = 'kitchen' and channel in ('kitchen', 'team'))
    or (s.role = 'owner' and channel = 'assistant' and exists (select 1 from public.mesa_assistant_conversation c where c.id = conversation_id and c.owner_id = auth.uid()))
  )));
create policy "staff post team messages" on public.mesa_message for insert to authenticated with check (
  channel = 'team' and sender_kind = 'user' and sender_id = auth.uid() and conversation_id is null and inquiry_id is null and link is null and dedupe_key is null and title is null
  and length(body) <= 2000
  and body !~* '([$€£¥]\s*[0-9])|([0-9][0-9.,]*\s*(usd|dollars?|bucks)\M)'
  and exists (select 1 from public.mesa_staff s where s.user_id = auth.uid() and s.role in ('owner', 'kitchen')));

create table if not exists public.mesa_message_read (
  user_id uuid not null references auth.users(id) on delete cascade,
  channel_key text not null check (length(channel_key) <= 80),
  last_read_at timestamptz not null default now(),
  primary key (user_id, channel_key)
);
alter table public.mesa_message_read enable row level security;
create policy "staff manage own read markers" on public.mesa_message_read for all to authenticated
  using (user_id = auth.uid()) with check (user_id = auth.uid() and exists (select 1 from public.mesa_staff where user_id = auth.uid()));

create or replace function public.mesa_unread_counts()
returns jsonb language sql stable security invoker set search_path = public as $$
  select coalesce(jsonb_object_agg(k, n), '{}'::jsonb) from (
    select case when m.channel = 'assistant' then 'assistant:' || m.conversation_id else m.channel end k, count(*) n
      from public.mesa_message m
      left join public.mesa_message_read r on r.user_id = auth.uid() and r.channel_key = case when m.channel = 'assistant' then 'assistant:' || m.conversation_id else m.channel end
     where (m.sender_id is distinct from auth.uid()) and m.created_at > coalesce(r.last_read_at, '-infinity'::timestamptz)
     group by 1) t
$$;

alter publication supabase_realtime add table public.mesa_message;

