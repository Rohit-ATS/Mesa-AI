create table if not exists public.mesa_auto_proposal (
  inquiry_id uuid primary key references public.inquiry(id) on delete cascade,
  status text not null default 'running' check (status in ('running','completed','failed')),
  quote_id uuid references public.quote(id) on delete set null,
  research_brief text,
  proposal_draft text,
  calculation_error text,
  email_status text check (email_status in ('accepted','failed','unknown','skipped')),
  email_recipients text[] not null default '{}',
  error text,
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now()
);
alter table public.mesa_auto_proposal enable row level security;
create policy "owners read auto proposals" on public.mesa_auto_proposal for select to authenticated using (exists (select 1 from public.mesa_staff s where s.user_id = auth.uid() and s.role = 'owner'));