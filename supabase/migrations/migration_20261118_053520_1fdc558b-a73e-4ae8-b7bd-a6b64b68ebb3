CREATE FUNCTION public.mesa_owner_metrics() RETURNS jsonb LANGUAGE plpgsql STABLE SECURITY INVOKER SET search_path=public AS $$
DECLARE result jsonb;
BEGIN
 IF NOT EXISTS (SELECT 1 FROM public.mesa_staff WHERE user_id=auth.uid() AND role='owner') THEN RAISE EXCEPTION 'Owner access required'; END IF;
 WITH approvals AS (SELECT inquiry_id, min(created_at) AS approved_at FROM public.quote WHERE status='approved' GROUP BY inquiry_id),
 relevant AS (SELECT i.*, m.clarification_rounds,m.dietary_confirmed,m.synthetic_demo,a.approved_at FROM public.inquiry i LEFT JOIN public.inquiry_metrics_context m ON m.inquiry_id=i.id LEFT JOIN approvals a ON a.inquiry_id=i.id),
 scored AS (SELECT r.*, (r.event_date IS NOT NULL AND r.event_time IS NOT NULL AND NULLIF(btrim(r.venue_address),'') IS NOT NULL AND r.service_style IS NOT NULL AND r.guest_count>0 AND r.dietary_confirmed IS TRUE AND EXISTS (SELECT 1 FROM public.order_line o WHERE o.inquiry_id=r.id) AND NOT EXISTS (SELECT 1 FROM public.order_line o WHERE o.inquiry_id=r.id AND (o.qty_servings<=0 OR NOT EXISTS (SELECT 1 FROM public.recipe_line x WHERE x.menu_item_id=o.menu_item_id) OR NOT EXISTS (SELECT 1 FROM public.prep_task t WHERE t.inquiry_id=r.id AND t.menu_item_id=o.menu_item_id AND t.due_at IS NOT NULL)))) AS handoff_complete FROM relevant r)
 SELECT jsonb_build_object('median_hours',percentile_cont(0.5) WITHIN GROUP (ORDER BY extract(epoch from (approved_at-created_at))/3600) FILTER (WHERE approved_at >= created_at), 'approval_count',count(*) FILTER (WHERE approved_at >= created_at), 'avg_clarifications',avg(clarification_rounds) FILTER (WHERE clarification_rounds IS NOT NULL), 'clarification_count',count(*) FILTER (WHERE clarification_rounds IS NOT NULL), 'total_inquiries',count(*), 'handoff_complete',count(*) FILTER (WHERE status='approved' AND handoff_complete), 'approved_count',count(*) FILTER (WHERE status='approved'), 'upsell_total',sum(upsell_value_usd) FILTER (WHERE (created_at AT TIME ZONE 'America/Los_Angeles') >= date_trunc('month',now() AT TIME ZONE 'America/Los_Angeles') AND (created_at AT TIME ZONE 'America/Los_Angeles') <= (now() AT TIME ZONE 'America/Los_Angeles') AND upsell_value_usd IS NOT NULL), 'upsell_recorded_count',count(*) FILTER (WHERE (created_at AT TIME ZONE 'America/Los_Angeles') >= date_trunc('month',now() AT TIME ZONE 'America/Los_Angeles') AND (created_at AT TIME ZONE 'America/Los_Angeles') <= (now() AT TIME ZONE 'America/Los_Angeles') AND upsell_value_usd IS NOT NULL), 'period_count',count(*) FILTER (WHERE (created_at AT TIME ZONE 'America/Los_Angeles') >= date_trunc('month',now() AT TIME ZONE 'America/Los_Angeles') AND (created_at AT TIME ZONE 'America/Los_Angeles') <= (now() AT TIME ZONE 'America/Los_Angeles')), 'synthetic_count',count(*) FILTER (WHERE synthetic_demo IS TRUE), 'period',to_char(now() AT TIME ZONE 'America/Los_Angeles','Month YYYY')) INTO result FROM scored;
 RETURN result;
END $$;
REVOKE ALL ON FUNCTION public.mesa_owner_metrics() FROM PUBLIC, anon;
GRANT EXECUTE ON FUNCTION public.mesa_owner_metrics() TO authenticated;