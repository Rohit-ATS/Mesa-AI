CREATE FUNCTION public.mesa_owner_session_metrics(p_since timestamptz) RETURNS jsonb LANGUAGE plpgsql STABLE SECURITY INVOKER SET search_path=public AS $$
DECLARE result jsonb;
BEGIN
 IF NOT EXISTS (SELECT 1 FROM public.mesa_staff WHERE user_id=auth.uid() AND role='owner') THEN RAISE EXCEPTION 'Owner access required'; END IF;
 IF p_since IS NULL OR p_since>now() THEN RAISE EXCEPTION 'Invalid session start'; END IF;
 WITH approvals AS (SELECT inquiry_id,min(created_at) approved_at FROM public.quote WHERE status='approved' GROUP BY inquiry_id), relevant AS (SELECT i.*,m.clarification_rounds,m.dietary_confirmed,a.approved_at FROM public.inquiry i LEFT JOIN public.inquiry_metrics_context m ON m.inquiry_id=i.id LEFT JOIN approvals a ON a.inquiry_id=i.id), scored AS (SELECT r.*, (r.event_date IS NOT NULL AND r.event_time IS NOT NULL AND NULLIF(btrim(r.venue_address),'') IS NOT NULL AND r.service_style IS NOT NULL AND r.guest_count>0 AND r.dietary_confirmed IS TRUE AND EXISTS (SELECT 1 FROM public.order_line o WHERE o.inquiry_id=r.id) AND NOT EXISTS (SELECT 1 FROM public.order_line o WHERE o.inquiry_id=r.id AND (o.qty_servings<=0 OR NOT EXISTS (SELECT 1 FROM public.recipe_line x WHERE x.menu_item_id=o.menu_item_id) OR NOT EXISTS (SELECT 1 FROM public.prep_task t WHERE t.inquiry_id=r.id AND t.menu_item_id=o.menu_item_id AND t.due_at IS NOT NULL)))) AS complete FROM relevant r)
 SELECT jsonb_build_object('median_hours',percentile_cont(0.5) WITHIN GROUP (ORDER BY extract(epoch FROM (approved_at-created_at))/3600) FILTER (WHERE approved_at >= p_since AND approved_at>=created_at),'approval_count',count(*) FILTER(WHERE approved_at>=p_since AND approved_at>=created_at),'avg_clarifications',avg(clarification_rounds) FILTER(WHERE created_at>=p_since AND clarification_rounds IS NOT NULL),'clarification_count',count(*) FILTER(WHERE created_at>=p_since AND clarification_rounds IS NOT NULL),'total_inquiries',count(*) FILTER(WHERE created_at>=p_since),'handoff_complete',count(*) FILTER(WHERE status='approved' AND complete),'approved_count',count(*) FILTER(WHERE status='approved'),'upsell_total',sum(upsell_value_usd) FILTER(WHERE created_at>=p_since AND upsell_value_usd IS NOT NULL),'upsell_recorded_count',count(*) FILTER(WHERE created_at>=p_since AND upsell_value_usd IS NOT NULL),'period_count',count(*) FILTER(WHERE created_at>=p_since),'synthetic_count',count(*) FILTER(WHERE created_at>=p_since),'period','this session') INTO result FROM scored;
 RETURN result;
END $$;
REVOKE ALL ON FUNCTION public.mesa_owner_session_metrics(timestamptz) FROM PUBLIC,anon;
GRANT EXECUTE ON FUNCTION public.mesa_owner_session_metrics(timestamptz) TO authenticated;